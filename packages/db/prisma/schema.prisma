// Speakwise database schema.
// All canonical entities from `Tech Arch & Data.md` §6 live here.
// Field names use snake_case in DB, camelCase in TS via Prisma's @map.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  learner
  admin
  tutor
  student
  organization_admin
}

enum CEFRLevel {
  complete_beginner
  beginner
  lower_intermediate
  intermediate
  upper_intermediate
  advanced
}

enum LearningStyle {
  mission
  tutor
  conversation
  drill
  balanced
}

enum CorrectionStyle {
  gentle
  direct
  strict
  end_of_task
  major_mistakes_only
  adaptive
}

enum WisePersonality {
  default
  friendly_tutor
  direct_coach
  game_master
  premium_assistant
  strict_grammar_coach
  casual_companion
}

/// Default UI mode for Wise interactions. `voice` is the original
/// orb-first experience; `text` is a read-and-type chat experience that
/// doesn't auto-narrate. Each screen can flip mode per-session.
enum InteractionMode {
  voice
  text
}

enum SkillCategory {
  pronunciation
  vocabulary
  grammar
  speaking
  listening
  reading
  writing
  culture
  fluency
}

enum SkillStatus {
  not_started
  introduced
  practicing
  needs_review
  proficient
  mastered
}

enum VocabStatus {
  new
  learning
  review
  mastered
  archived
}

enum LessonType {
  daily_mission
  recovery
  freestyle
  grammar
  vocabulary_review
  speaking_challenge
  listening_challenge
  media
  scenario_roleplay
  progress_check
  placement
}

enum LessonStatus {
  draft
  recommended
  active
  completed
  skipped
  archived
}

enum LessonAuthor {
  wise
  user
  admin
  tutor
}

enum TaskType {
  briefing
  explanation
  multiple_choice
  fill_blank
  translation
  conjugation
  pronoun_replacement
  tense_selection
  error_correction
  speaking_prompt
  listening_comprehension
  roleplay
  recap
  media_clip
  reflection
}

enum SessionType {
  onboarding
  placement
  lesson
  freestyle
  review
  conversation
  media
  progress_report
}

enum SessionMode {
  voice
  text
  mixed
}

enum SessionStatus {
  active
  completed
  abandoned
  errored
}

enum InputType {
  voice
  text
  multiple_choice
  selection
}

enum CorrectionType {
  grammar
  vocabulary
  pronunciation
  spelling
  word_order
  tone
  comprehension
  fluency
  other
}

enum CorrectionSeverity {
  minor
  moderate
  major
}

enum MemoryType {
  preference
  goal
  interest
  strength
  weakness
  recurring_mistake
  tutor_observation
  motivation
  content_preference
  correction_preference
  pronunciation_note
  session_summary
}

enum MemoryVisibility {
  user_visible
  internal
}

enum MediaSourceType {
  youtube
  uploaded
  licensed
  ai_generated
  article
  transcript
  other
}

enum RightsStatus {
  unknown
  user_provided
  public
  licensed
  ai_generated
  restricted
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  email           String?   @unique
  role            UserRole  @default(learner)
  nativeLanguage  String    @default("en") @map("native_language")
  targetLanguage  String    @default("it") @map("target_language")
  timezone        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastActiveAt    DateTime? @map("last_active_at")

  profile          LearnerProfile?
  tutorProfile     TutorProfile?
  studentLinks     TutorStudent[]    @relation("StudentTutorLinks")
  directivesReceived TutorDirective[] @relation("StudentDirectives")
  skillProgress    UserSkillProgress[]
  vocabularyItems  VocabularyItem[]
  lessons          Lesson[]
  sessions         Session[]
  memoryNotes      MemoryNote[]
  events           UserEvent[]
  streak           UserStreak?
  xpLedger         XpEntry[]

  @@map("users")
}

model LearnerProfile {
  id                              String          @id @default(uuid()) @db.Uuid
  userId                          String          @unique @map("user_id") @db.Uuid
  currentLevel                    CEFRLevel       @default(beginner) @map("current_level")
  levelConfidence                 Decimal?        @map("level_confidence") @db.Decimal(3, 2)
  goals                           String[]        @default([])
  interests                       String[]        @default([])
  preferredLearningStyle          LearningStyle   @default(balanced) @map("preferred_learning_style")
  preferredCorrectionStyle        CorrectionStyle @default(adaptive) @map("preferred_correction_style")
  preferredWisePersonality        WisePersonality @default(default) @map("preferred_wise_personality")
  preferredSessionLengthMinutes   Int?            @map("preferred_session_length_minutes")
  preferredFrequency              String?         @map("preferred_frequency")
  motivationNotes                 String?         @map("motivation_notes") @db.Text
  /// ElevenLabs voice ID. Null = use app default (see packages/ai/src/voices.ts).
  wiseVoiceId                     String?         @map("wise_voice_id")
  /// What share of Wise's spoken output should be Italian. 0.0 = English-only,
  /// 1.0 = full immersion. Default scales by level (see profile service).
  /// Beginner default is 0.1 — Italian only for already-covered material.
  languageRatio                   Decimal         @default(0.1) @map("language_ratio") @db.Decimal(3, 2)
  /// Hard "Italian-only" toggle. Overrides languageRatio when true.
  immersionMode                   Boolean         @default(false) @map("immersion_mode")
  /// When true, the stored `languageRatio` is a manual override the user
  /// set on the profile page. When false, the ratio is recomputed each
  /// request from the learner's CEFR level + mastery progress so it
  /// adapts naturally (no manual chip on the home page).
  languageRatioOverridden         Boolean         @default(false) @map("language_ratio_overridden")
  /// Default UI mode for Wise interactions:
  ///   voice — Wise auto-speaks and the learner answers by voice (orb-first).
  ///   text  — Wise shows text immediately, no auto-narration, learner types.
  /// Each screen can still flip mode for the session; this is the default.
  preferredInteractionMode        InteractionMode @default(voice) @map("preferred_interaction_mode")
  onboardingCompleted             Boolean         @default(false) @map("onboarding_completed")
  createdAt                       DateTime        @default(now()) @map("created_at")
  updatedAt                       DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

/// A book-aligned unit of the curriculum — one per Prego! chapter
/// (Capitolo Preliminare, 1–18) plus an advanced/appendix unit. Groups the
/// skills, lesson templates, and thematic vocabulary that belong together and
/// gives the learner a navigable "course path." Skills remain the atomic unit
/// the engine targets; the unit is the chapter wrapper around them.
model CurriculumUnit {
  id            String    @id @default(uuid()) @db.Uuid
  language      String    @default("it")
  /// Stable code, e.g. "cap-00" (Preliminare), "cap-01" … "cap-18", "appendix".
  code          String    @unique
  /// Position in the course path (0 = Preliminare).
  order         Int
  title         String
  subtitle      String?
  /// Primary interest theme the chapter is built around (maps to the learner
  /// interest themes: travel, food, family, sports, music, politics …). The
  /// personalization layer can still re-theme, but this is the native fit.
  theme         String
  level         CEFRLevel
  summary       String    @db.Text
  /// CEFR-style "can-do" statements the learner achieves by finishing the unit.
  canDo         String[]  @default([]) @map("can_do")
  /// Cultural notes for the chapter (Curiosità / L'Italia regionale style):
  /// array of { title, body } objects. Drives culture tasks + readings.
  culturalNotes Json      @default("[]") @map("cultural_notes")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  skills          CurriculumSkill[]
  lessonTemplates CurriculumLessonTemplate[]
  vocabulary      CurriculumVocabulary[]

  @@index([order])
  @@map("curriculum_units")
}

model CurriculumSkill {
  id            String        @id @default(uuid()) @db.Uuid
  language      String        @default("it")
  name          String
  slug          String        @unique
  category      SkillCategory
  level         CEFRLevel
  description   String        @db.Text
  prerequisites String[]      @default([]) @db.Uuid
  examples      Json          @default("[]")
  isActive      Boolean       @default(true) @map("is_active")

  // ─── Book-aligned content layer (Prego!-derived curriculum) ───────────────
  /// The chapter/unit this skill belongs to. Null for legacy/cross-cutting
  /// skills not yet mapped to a unit.
  unitId        String?       @map("unit_id") @db.Uuid
  /// Display order within the unit (chapter), so the course path renders in
  /// the book's pedagogical sequence.
  orderInUnit   Int?          @map("order_in_unit")
  /// The classic learner errors for this skill. Fed to the lesson generator
  /// so tasks deliberately probe these, and to the correction engine so it
  /// recognizes them. e.g. "wrong auxiliary (avere vs essere)".
  commonMistakes           String[]   @default([]) @map("common_mistakes")
  /// Task types best suited to drilling this skill. Steers the lesson
  /// generator's task mix toward what actually teaches this point.
  recommendedPracticeTypes TaskType[] @default([]) @map("recommended_practice_types")
  /// Interest themes this skill personalizes well into (food, travel,
  /// politics …). Lets Wise theme the same grammar to the learner's interests.
  compatibleThemes         String[]   @default([]) @map("compatible_themes")
  /// Pedagogical notes for Wise: how to explain it, what to contrast it with,
  /// what to avoid. Never shown raw to the learner — it shapes generation.
  teachingNotes            String?    @db.Text @map("teaching_notes")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  unit         CurriculumUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  userProgress UserSkillProgress[]

  @@index([level])
  @@index([category])
  @@index([unitId])
  @@map("curriculum_skills")
}

model UserSkillProgress {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  skillId           String       @map("skill_id") @db.Uuid
  status            SkillStatus  @default(not_started)
  masteryScore      Decimal      @default(0) @map("mastery_score") @db.Decimal(4, 3)
  /// 0..1 — how confidently the learner can RECOGNIZE / understand this
  /// skill when Wise speaks it (passive). Bumped on listening_comprehension,
  /// multiple_choice, and any task where the model emits Italian and the
  /// learner picks/recognizes.
  comprehensionScore Decimal     @default(0) @map("comprehension_score") @db.Decimal(4, 3)
  /// 0..1 — how confidently the learner can PRODUCE this skill in
  /// Italian (active). Bumped on speaking_prompt, translation, roleplay,
  /// or any task where the learner generates Italian.
  productionScore    Decimal     @default(0) @map("production_score") @db.Decimal(4, 3)
  exposureCount     Int          @default(0) @map("exposure_count")
  correctCount      Int          @default(0) @map("correct_count")
  incorrectCount    Int          @default(0) @map("incorrect_count")
  lastPracticedAt   DateTime?    @map("last_practiced_at")
  nextReviewAt      DateTime?    @map("next_review_at")
  mistakeCount      Int          @default(0) @map("mistake_count")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill CurriculumSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, status])
  @@index([nextReviewAt])
  @@map("user_skill_progress")
}

/// A canonical, reusable lesson blueprint anchored to a unit (chapter). This
/// is how "many lessons per chapter" lives as durable, authored content: each
/// template defines an objective, a task arc, and which skills it exercises.
/// The lesson engine personalizes a template into a concrete per-user Lesson
/// (theming examples/scenarios to the learner's interests) rather than
/// generating from scratch — so every chapter ships a structured set of
/// lessons while staying personal. Templates are content, not per-user rows.
model CurriculumLessonTemplate {
  id                     String     @id @default(uuid()) @db.Uuid
  unitId                 String     @map("unit_id") @db.Uuid
  slug                   String     @unique
  title                  String
  lessonType             LessonType @map("lesson_type")
  /// Order within the unit's lesson sequence.
  order                  Int
  level                  CEFRLevel
  summary                String     @db.Text
  /// Slugs of the CurriculumSkills this lesson is designed to teach/practice.
  objectiveSkillSlugs    String[]   @default([]) @map("objective_skill_slugs")
  /// Ordered array of task specs ({ taskType, focus, prompt, exampleAnswer,
  /// notes }) the engine expands + personalizes into real LessonTasks.
  taskBlueprint          Json       @default("[]") @map("task_blueprint")
  defaultDurationMinutes Int        @default(10) @map("default_duration_minutes")
  /// Interest themes this lesson personalizes well into.
  compatibleThemes       String[]   @default([]) @map("compatible_themes")
  isActive               Boolean    @default(true) @map("is_active")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  unit CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, order])
  @@map("curriculum_lesson_templates")
}

/// Canonical thematic vocabulary for a unit (the Vocabolario preliminare of
/// each chapter). Theme-tagged and ordered. When a learner reaches the unit,
/// these are materialized into their personal VocabularyItem rows (with SRS
/// scheduling). Keeping a canonical bank means vocab is authored once, stays
/// consistent, and powers vocabulary_review lessons without per-user authoring.
model CurriculumVocabulary {
  id                 String   @id @default(uuid()) @db.Uuid
  unitId             String   @map("unit_id") @db.Uuid
  slug               String   @unique
  targetText         String   @map("target_text")
  nativeText         String   @map("native_text")
  partOfSpeech       String?  @map("part_of_speech")
  /// "m" | "f" | "m/f" | null — grammatical gender, drives article practice.
  gender             String?
  exampleSentence    String?  @map("example_sentence") @db.Text
  exampleTranslation String?  @map("example_translation") @db.Text
  /// Sub-theme tag within the chapter (e.g. "luoghi", "mezzi di trasporto").
  theme              String?
  /// "neutral" | "formal" | "informal" | "colloquial" — register hint.
  register           String?
  order              Int
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  unit CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, order])
  @@map("curriculum_vocabulary")
}

model VocabularyItem {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  targetText          String      @map("target_text")
  nativeText          String      @map("native_text")
  partOfSpeech        String?     @map("part_of_speech")
  exampleSentence     String?     @map("example_sentence") @db.Text
  exampleTranslation  String?     @map("example_translation") @db.Text
  status              VocabStatus @default(new)
  tags                String[]    @default([])
  sourceLessonId      String?     @map("source_lesson_id") @db.Uuid
  sourceSessionId     String?     @map("source_session_id") @db.Uuid
  masteryScore        Decimal     @default(0) @map("mastery_score") @db.Decimal(4, 3)
  exposureCount       Int         @default(0) @map("exposure_count")
  correctCount        Int         @default(0) @map("correct_count")
  incorrectCount      Int         @default(0) @map("incorrect_count")
  lastReviewedAt      DateTime?   @map("last_reviewed_at")
  nextReviewAt        DateTime?   @map("next_review_at")
  lastReviewToken     String?     @map("last_review_token") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@map("vocabulary_items")
}

model Lesson {
  id                       String       @id @default(uuid()) @db.Uuid
  userId                   String       @map("user_id") @db.Uuid
  title                    String
  lessonType               LessonType   @map("lesson_type")
  status                   LessonStatus @default(draft)
  targetSkillIds           String[]     @default([]) @map("target_skill_ids") @db.Uuid
  interestTheme            String?      @map("interest_theme")
  estimatedDurationMinutes Int?         @map("estimated_duration_minutes")
  difficultyLevel          CEFRLevel    @default(beginner) @map("difficulty_level")
  generationContext        Json         @default("{}") @map("generation_context")
  content                  Json         @default("{}")
  createdBy                LessonAuthor @default(wise) @map("created_by")
  /// Set when the lesson was generated under a tutor's active directive,
  /// so we can audit "which directive drove which lesson" and surface it
  /// in the tutor's view.
  tutorDirectiveId         String?      @map("tutor_directive_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  completedAt              DateTime?    @map("completed_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorDirective  TutorDirective?  @relation("LessonFromDirective", fields: [tutorDirectiveId], references: [id])
  tasks           LessonTask[]
  sessions        Session[]

  @@index([userId, status])
  @@index([userId, lessonType])
  @@index([tutorDirectiveId])
  @@map("lessons")
}

model LessonTask {
  id                 String   @id @default(uuid()) @db.Uuid
  lessonId           String   @map("lesson_id") @db.Uuid
  taskType           TaskType @map("task_type")
  orderIndex         Int      @map("order_index")
  prompt             String   @db.Text
  targetSkillIds     String[] @default([]) @map("target_skill_ids") @db.Uuid
  vocabularyItemIds  String[] @default([]) @map("vocabulary_item_ids") @db.Uuid
  expectedAnswer     Json?    @map("expected_answer")
  options            Json?
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  responses UserResponse[]

  @@unique([lessonId, orderIndex])
  @@map("lesson_tasks")
}

model Session {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  lessonId              String?       @map("lesson_id") @db.Uuid
  sessionType           SessionType   @map("session_type")
  mode                  SessionMode   @default(text)
  status                SessionStatus @default(active)
  transcript            Json?
  summary               String?       @db.Text
  strengthsObserved     String[]      @default([]) @map("strengths_observed")
  weaknessesObserved    String[]      @default([]) @map("weaknesses_observed")
  memoryUpdatesApplied  Boolean       @default(false) @map("memory_updates_applied")
  startedAt             DateTime      @default(now()) @map("started_at")
  completedAt           DateTime?     @map("completed_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  responses UserResponse[]

  @@index([userId, status])
  @@map("sessions")
}

model UserResponse {
  id                 String     @id @default(uuid()) @db.Uuid
  sessionId          String     @map("session_id") @db.Uuid
  lessonTaskId       String?    @map("lesson_task_id") @db.Uuid
  inputType          InputType  @map("input_type")
  userAnswer         String     @map("user_answer") @db.Text
  transcription      String?    @db.Text
  correctedAnswer    String?    @map("corrected_answer") @db.Text
  isCorrect          Boolean?   @map("is_correct")
  score              Decimal?   @db.Decimal(4, 3)
  feedback           String?    @db.Text
  grammarTags        String[]   @default([]) @map("grammar_tags")
  vocabularyItemIds  String[]   @default([]) @map("vocabulary_item_ids") @db.Uuid
  skillIds           String[]   @default([]) @map("skill_ids") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lessonTask  LessonTask?  @relation(fields: [lessonTaskId], references: [id], onDelete: SetNull)
  corrections Correction[]

  @@index([sessionId])
  @@unique([sessionId, lessonTaskId])
  @@map("user_responses")
}

model Correction {
  id              String             @id @default(uuid()) @db.Uuid
  userResponseId  String             @unique @map("user_response_id") @db.Uuid
  correctionType  CorrectionType     @map("correction_type")
  severity        CorrectionSeverity @default(moderate)
  originalText    String             @map("original_text") @db.Text
  correctedText   String             @map("corrected_text") @db.Text
  explanation     String             @db.Text
  encouragement   String?            @db.Text
  retryPrompt     String?            @map("retry_prompt") @db.Text
  skillIds        String[]           @default([]) @map("skill_ids") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")

  userResponse UserResponse @relation(fields: [userResponseId], references: [id], onDelete: Cascade)

  @@index([userResponseId])
  @@map("corrections")
}

model MemoryNote {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              MemoryType
  content           String           @db.Text
  dedupeKey         String           @map("dedupe_key")
  structuredData    Json?            @map("structured_data")
  confidence        Decimal          @default(0.5) @db.Decimal(3, 2)
  visibility        MemoryVisibility @default(internal)
  sourceSessionId   String?          @map("source_session_id") @db.Uuid
  sourceResponseId  String?          @map("source_response_id") @db.Uuid
  embedding         Unsupported("vector(1536)")?
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, isActive])
  @@unique([userId, dedupeKey])
  @@map("memory_notes")
}

model MediaItem {
  id              String          @id @default(uuid()) @db.Uuid
  sourceType      MediaSourceType @map("source_type")
  sourceUrl       String?         @map("source_url") @db.Text
  title           String
  language        String          @default("it")
  transcript      String?         @db.Text
  durationSeconds Int?            @map("duration_seconds")
  tags            String[]        @default([])
  rightsStatus    RightsStatus    @default(unknown) @map("rights_status")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([sourceType])
  @@map("media_items")
}

model UserEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, eventType])
  @@index([eventType, createdAt])
  @@map("user_events")
}

// ─── Gamification (PRD 09) ────────────────────────────────────────────────

model UserStreak {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  currentDays       Int       @default(0) @map("current_days")
  longestDays       Int       @default(0) @map("longest_days")
  lastActiveDate    DateTime? @map("last_active_date") @db.Date
  freezeTokens      Int       @default(0) @map("freeze_tokens")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model XpEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String
  sourceId  String?  @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId, reason, sourceId])
  @@map("xp_entries")
}

// ─── Admin / Prompt Ops (PRD 13) ──────────────────────────────────────────

model PromptTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  version     Int
  purpose     String
  body        String   @db.Text
  inputs      Json     @default("[]")
  outputSchema Json?   @map("output_schema")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([key, version])
  @@map("prompt_templates")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(false)
  rolloutPct Int     @default(0) @map("rollout_pct")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ── Tutor / Classroom ────────────────────────────────────────────────────
//
// A `TutorProfile` is the tutor-side counterpart of `LearnerProfile`.
// Admin-provisioned (no self-service signup); the CLI in
// `scripts/create-user.ts` creates the row alongside the User. Each
// tutor has a single rotatable `inviteCode` — students enter it to
// link their account to the tutor via `TutorStudent`.

model TutorProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String?  @map("display_name")
  bio         String?  @db.Text
  /// Languages the tutor specializes in (e.g. ["it"]). Multi-language ready.
  specialties String[] @default([])
  /// Random 8-char invite code; students enter it to link. Rotatable.
  inviteCode  String   @unique @map("invite_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students   TutorStudent[]
  directives TutorDirective[]

  @@map("tutor_profiles")
}

model TutorStudent {
  id          String              @id @default(uuid()) @db.Uuid
  tutorId     String              @map("tutor_id") @db.Uuid
  studentId   String              @map("student_id") @db.Uuid
  status      TutorStudentStatus  @default(active)
  connectedAt DateTime            @default(now()) @map("connected_at")
  endedAt     DateTime?           @map("ended_at")

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User         @relation("StudentTutorLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId])
  @@index([studentId, status])
  @@map("tutor_students")
}

enum TutorStudentStatus {
  active
  paused
  ended
}

/// A directive is the tutor's standing instruction to Wise: a free-text
/// focus area + an optional list of CurriculumSkill IDs to prioritize.
/// Lesson generation reads the latest `active` directive for the student
/// and uses it to override `targetSkillIds` + flavor the briefing.
model TutorDirective {
  id              String          @id @default(uuid()) @db.Uuid
  tutorId         String          @map("tutor_id") @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  /// Free-text guidance Wise can read ("focus on past tense this week").
  body            String          @db.Text
  /// CurriculumSkill UUIDs the tutor wants prioritized in upcoming lessons.
  pinnedSkillIds  String[]        @default([]) @map("pinned_skill_ids") @db.Uuid
  status          DirectiveStatus @default(active)
  /// Optional auto-archive date — if null, stays active until archived.
  expiresAt       DateTime?       @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User         @relation("StudentDirectives", fields: [studentId], references: [id], onDelete: Cascade)
  lessons Lesson[]     @relation("LessonFromDirective")

  @@index([studentId, status])
  @@map("tutor_directives")
}

enum DirectiveStatus {
  active
  archived
}

/// Dedup ledger for the in-process scheduler. Before running a scheduled job,
/// the scheduler claims its time window by inserting (job, windowKey); the
/// unique constraint means only one runner — across restarts or multiple
/// instances — actually executes that window. Lets the cron logic live inside
/// the web service instead of as separate Render cron services.
model CronRun {
  id        String   @id @default(uuid()) @db.Uuid
  job       String
  /// Identifies the schedule window, e.g. "2026-06-01" (daily) or
  /// "2026-06-01T14" (hourly, UTC).
  windowKey String   @map("window_key")
  ranAt     DateTime @default(now()) @map("ran_at")
  result    Json?

  @@unique([job, windowKey])
  @@map("cron_runs")
}
