{
  "name": "speakwise",
  "private": true,
  "version": "0.0.1",
  "description": "Speakwise — voice-first AI Italian tutor.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "pnpm --filter speakwise-web exec vitest run tests/unit",
    "test:integration": "APP_URL=http://localhost:${PORT:-3001} pnpm --filter speakwise-web exec vitest run tests/integration",
    "test:e2e": "pnpm --filter speakwise-web exec playwright test",
    "test:all": "pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "db:generate": "pnpm --filter @speakwise/db prisma:generate",
    "db:migrate": "pnpm --filter @speakwise/db prisma:migrate",
    "db:seed": "pnpm --filter @speakwise/db seed",
    "smoke": "tsx scripts/smoke-test.ts",
    "user:create": "tsx scripts/create-user.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
