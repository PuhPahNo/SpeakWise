# ─────────────────────────────────────────────────────────────────────────
# Speakwise environment.
#
# Copy this file to `.env.local` for local dev. Do NOT commit `.env.local`.
# In production, set these as Render Environment Variables — `render.yaml`
# already declares the keys; Render will prompt you for any without values.
#
# Categories:
#   1. Core
#   2. Database (Render Postgres)
#   3. Auth (Clerk)
#   4. AI (OpenAI + ElevenLabs)
#   5. Observability (Sentry, PostHog) — optional but recommended
#   6. Cron / internal
# ─────────────────────────────────────────────────────────────────────────

# ── 1. Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 2. Database ──────────────────────────────────────────────────────────
# Render Postgres provides these. For local dev, run a Postgres with
# `pgvector` installed (e.g. `docker run -d --name pg -p 5432:5432 \
#   -e POSTGRES_PASSWORD=postgres ankane/pgvector`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speakwise?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/speakwise?schema=public"

# ── 3. Auth ──────────────────────────────────────────────────────────────
# Sign-in is username + password against our own users table. No external
# auth vendor. Accounts are admin-provisioned via:
#   pnpm tsx scripts/create-user.ts <username>
# (or `node --experimental-strip-types --env-file=.env scripts/create-user.ts <username>`)
#
# AUTH_SESSION_SECRET encrypts session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SESSION_SECRET=

# ── 4. AI ────────────────────────────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_STT=whisper-1

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
# Voice IDs are NOT set here — there is a curated picker in the app
# (Profile → Wise's voice). Defaults live in packages/ai/src/voices.ts.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── 5. Observability (optional) ──────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── 6. Cron / internal ───────────────────────────────────────────────────
# Random 32+ char secret used to authenticate Render Cron Job calls into
# /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=
